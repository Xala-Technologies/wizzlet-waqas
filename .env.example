# Client (Vite) — copy to .env.local. Never commit real secrets.
# Docs: docs/environments.md

# Deployment identity (independent of Vite --mode)
VITE_APP_ENV=local

VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# Optional site URL (Convex Auth HTTP routes)
# VITE_CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site

# Stripe (browser) — never put the secret key here
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Client UI gate for sandbox fallback (still requires Convex ALLOW_SANDBOX_CHECKOUT=true)
# Enabled only when value is exactly true — "false" does not enable.
# VITE_ALLOW_SANDBOX_CHECKOUT=true

# Optional build stamps (CI sets these; vite.config also derives SHA from git)
# VITE_RELEASE_SHA=
# VITE_RELEASE_CHANNEL=local

# CLI target for `npx convex dev` (written by Convex CLI; do not invent production here)
# CONVEX_DEPLOYMENT=dev:your-deployment

# ---------------------------------------------------------------------------
# Convex dashboard env (Settings → Environment Variables on the TARGET deployment)
# These are NOT loaded from this file into the hosted backend.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # required for /stripe/webhook
# SITE_URL=http://localhost:8080    # production: https://www.prizelet.com
# ALLOW_SANDBOX_CHECKOUT=true       # non-prod sandbox only — never true in production
# ALLOW_DEV_ADMIN_GRANT=true        # dev only — never true in production
# MIGRATION_SECRET=...              # ETL gate — prefer unset after cutover
#
# OAuth (Convex Auth) — callback base is https://YOUR_DEPLOYMENT.convex.site/api/auth/callback/{provider}
# AUTH_TWITTER_ID=...
# AUTH_TWITTER_SECRET=...
# AUTH_DISCORD_ID=...
# AUTH_DISCORD_SECRET=...
# DISCORD_BOT_TOKEN=...             # bot with Manage Roles for subscriber role sync
