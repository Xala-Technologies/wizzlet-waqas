VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
# Optional site URL (Convex Auth HTTP routes)
# VITE_CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site

# Stripe (browser) — never put the secret key here
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Client UI gate for sandbox fallback (still requires Convex ALLOW_SANDBOX_CHECKOUT=true)
# VITE_ALLOW_SANDBOX_CHECKOUT=true

# Convex deployment env (Dashboard → Settings → Environment Variables):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # required for /stripe/webhook
# ALLOW_SANDBOX_CHECKOUT=true       # non-prod sandbox only
# SITE_URL=http://localhost:8080
