# Local / Vite — always point at the DEV Convex deployment (not production)
VITE_CONVEX_URL=https://combative-mongoose-559.convex.cloud
VITE_CONVEX_SITE_URL=https://combative-mongoose-559.convex.site

# Stripe (browser) — never put the secret key here
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Client UI gate for sandbox fallback (still requires Convex ALLOW_SANDBOX_CHECKOUT=true)
# VITE_ALLOW_SANDBOX_CHECKOUT=true

# Convex dashboard env — set separately on DEV and PROD deployments:
# DEV  (npx convex env set …)     SITE_URL=http://127.0.0.1:8080
# PROD (npx convex env set --prod) SITE_URL=https://www.prizelet.com
#   prod cloud: https://ceaseless-weasel-494.convex.cloud
#   prod site:  https://ceaseless-weasel-494.convex.site
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # webhook URL must match the deployment .convex.site
# ALLOW_SANDBOX_CHECKOUT=true       # DEV only
# ALLOW_DEV_ADMIN_GRANT=true        # DEV only — never on prod
# OAuth callbacks: https://<deployment>.convex.site/api/auth/callback/{provider}
# AUTH_TWITTER_ID=...
# AUTH_TWITTER_SECRET=...
# AUTH_DISCORD_ID=...
# AUTH_DISCORD_SECRET=...
# DISCORD_BOT_TOKEN=...             # bot with Manage Roles for subscriber role sync
