# Local / Vite — always point at the DEV Convex deployment (not production)
# Docs: docs/environments.md
VITE_APP_ENV=local
VITE_CONVEX_URL=https://combative-mongoose-559.convex.cloud
VITE_CONVEX_SITE_URL=https://combative-mongoose-559.convex.site
# Must match Convex SITE_URL on the DEV deployment (OAuth redirectTo)
VITE_SITE_URL=http://127.0.0.1:8080

# Stripe (browser) — never put the secret key here
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Client UI gate for sandbox fallback (still requires Convex ALLOW_SANDBOX_CHECKOUT=true)
# Enabled only when value is exactly true — "false" does not enable.
# VITE_ALLOW_SANDBOX_CHECKOUT=true

# Optional build stamps (CI sets these; vite.config also derives SHA from git)
# VITE_RELEASE_SHA=
# VITE_RELEASE_CHANNEL=local

# CLI target for `npx convex dev` (written by Convex CLI; do not invent production here)
# CONVEX_DEPLOYMENT=dev:combative-mongoose-559

# ---------------------------------------------------------------------------
# Convex dashboard env — set separately on DEV and PROD deployments.
# These are NOT loaded from this file into the hosted backend.
# ---------------------------------------------------------------------------
# DEV  (npx convex env set …)      SITE_URL=http://127.0.0.1:8080
# PROD (npx convex env set --prod) SITE_URL=https://www.sweeph.com
#   prod cloud: https://ceaseless-weasel-494.convex.cloud
#   prod site:  https://ceaseless-weasel-494.convex.site
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # webhook URL must match the deployment .convex.site
# STRIPE_CONNECT_COUNTRY=US         # Express country; keep aligned with USD ledger/Checkout (not NO while prices are USD)
# ALLOW_SANDBOX_CHECKOUT=true       # DEV only — never true in production
# ALLOW_DEV_ADMIN_GRANT=true        # DEV only — never on prod
# MIGRATION_SECRET=...              # ETL gate — prefer unset after cutover
# OAuth callbacks: https://<deployment>.convex.site/api/auth/callback/{provider}
# AUTH_TWITTER_ID=...
# AUTH_TWITTER_SECRET=...
# AUTH_DISCORD_ID=...
# AUTH_DISCORD_SECRET=...
# DISCORD_BOT_TOKEN=...             # bot with Manage Roles + Create Invite
# DISCORD_CLIENT_ID=...             # bot application id (defaults to AUTH_DISCORD_ID)
# DISCORD_CLIENT_SECRET=...         # optional; defaults to AUTH_DISCORD_SECRET
# Redirect: https://<deployment>.convex.site/discord/bot-install/callback
# Bot OAuth permissions integer: 268435457 (Manage Roles + Create Instant Invite)
# RESEND_API_KEY=re_...            # transactional email (email-change OTP)
# EMAIL_FROM=Prizelet <noreply@sweeph.com>
