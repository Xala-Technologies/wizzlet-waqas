VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# Optional: allow sandbox checkout outside `npm run dev` (never enable in real prod)
# VITE_ALLOW_SANDBOX_CHECKOUT=true

# Edge function secret (set in Supabase Dashboard → Edge Functions → Secrets):
# ALLOW_SANDBOX_CHECKOUT=true
